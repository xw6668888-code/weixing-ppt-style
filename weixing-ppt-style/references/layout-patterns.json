{
  "schema_version": 1,
  "distribution": "text-only",
  "patterns": [
    {
      "id": "T01",
      "title": "共同需求—任务列—共同目标",
      "profiles": [
        "research",
        "banner",
        "classic"
      ],
      "tags": [
        "研究内容",
        "研究思路",
        "任务分解",
        "共同目标"
      ],
      "structure": "总题与需求横框 → 编号任务列 → 共同目标；左侧层级短签",
      "components": [
        "B01",
        "B06"
      ],
      "guidance": "任务列保留方法、图文与输出；数量来自当前材料。",
      "reference": "references/composition-playbook.md"
    },
    {
      "id": "T02",
      "title": "课题与相互接口",
      "profiles": [
        "research",
        "classic",
        "weekly"
      ],
      "tags": [
        "研究内容",
        "课题",
        "任务关系",
        "接口"
      ],
      "structure": "分离题签与框体；列内对象、动作和机制；列间真实接口",
      "components": [
        "B05",
        "B06"
      ],
      "guidance": "外层可以同宽，内部图文允许不同；双向接口须有真实语义。",
      "reference": "references/composition-playbook.md"
    },
    {
      "id": "T03",
      "title": "双技术树",
      "profiles": [
        "research",
        "banner",
        "classic"
      ],
      "tags": [
        "技术路线",
        "研究内容",
        "分支",
        "汇聚"
      ],
      "structure": "父题签 → 方法图文框 → 浅蓝能力块 → 共同输出",
      "components": [
        "B06"
      ],
      "guidance": "同时保留父分叉与子汇聚；节点数量以实际方法为准。",
      "reference": "references/composition-playbook.md"
    },
    {
      "id": "T04",
      "title": "嵌套系统与分层支撑",
      "profiles": [
        "weekly",
        "research",
        "banner",
        "classic"
      ],
      "tags": [
        "总体架构",
        "系统",
        "分层",
        "子模块"
      ],
      "structure": "主张 → 大模块 → 子系统 → 节点；区分同层流程与跨层支撑",
      "components": [
        "B05",
        "B09"
      ],
      "guidance": "无填充虚线框配居中有底色标题牌，层级不能全靠颜色。",
      "reference": "references/composition-playbook.md"
    },
    {
      "id": "T05",
      "title": "技术泳道与共享评估",
      "profiles": [
        "research",
        "banner",
        "weekly"
      ],
      "tags": [
        "技术路线",
        "评估",
        "验证",
        "泳道",
        "共享"
      ],
      "structure": "左侧多条任务泳道 → 右侧贯穿评估栏 → 底部结论",
      "components": [
        "B07"
      ],
      "guidance": "多条技术共用同一验证体系时适用，指标与评价方式明确。",
      "reference": "references/composition-playbook.md"
    },
    {
      "id": "T06",
      "title": "架构大图与编号侧注",
      "profiles": [
        "weekly",
        "research",
        "banner",
        "classic"
      ],
      "tags": [
        "架构",
        "创新",
        "解释",
        "侧注"
      ],
      "structure": "约64%主图＋约33%编号侧注；虚线对应具体图中部位",
      "components": [
        "B07"
      ],
      "guidance": "保留主图细节，避免引线穿过主标签。",
      "reference": "references/composition-playbook.md"
    },
    {
      "id": "T07",
      "title": "多输入与知识交互",
      "profiles": [
        "research",
        "banner",
        "weekly"
      ],
      "tags": [
        "技术路线",
        "知识",
        "模型",
        "反馈",
        "数据流"
      ],
      "structure": "输入与图注 → 中部处理主链 → 输出；侧边知识块与外绕反馈",
      "components": [
        "B05",
        "B09"
      ],
      "guidance": "先布端口再布连接；多路输入先融合再输出。",
      "reference": "references/composition-playbook.md"
    },
    {
      "id": "T08",
      "title": "输入—模型—多任务结果",
      "profiles": [
        "weekly",
        "research"
      ],
      "tags": [
        "模型结构",
        "网络",
        "多任务",
        "结果",
        "指标"
      ],
      "structure": "左输入长栏 → 中部模型及下挂任务头 → 右侧后处理与邻近指标",
      "components": [
        "B05",
        "B06"
      ],
      "guidance": "采用不等高分区，不虚构模型层或额外输出。",
      "reference": "references/composition-playbook.md"
    },
    {
      "id": "T09",
      "title": "工序—实物—结构属性",
      "profiles": [
        "weekly",
        "research",
        "classic"
      ],
